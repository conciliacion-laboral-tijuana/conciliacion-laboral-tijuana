{
  "manifest_version": 3,
  "name": "Conciliación BC — Asistente",
  "version": "1.0.0",
  "description": "Llena automáticamente el formulario de conciliación del portal de Baja California con los datos de tu expediente, y guarda el folio y el acuse en la app.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://app.conciliacionbc.gob.mx/*",
    "https://*.railway.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conciliación BC — Asistente",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://app.conciliacionbc.gob.mx/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
